{
  "name": "dsh-device-auth",
  "version": "0.1.0",
  "description": "Stable, revocable per-device login tokens for the DeepSeek Harness Web UI — paired clients survive restarts without copying the rotating launch token",
  "icon": "icon.svg",
  "type": "module",
  "license": "MIT",
  "author": "nypyp",
  "homepage": "https://github.com/nypyp/dsh-device-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nypyp/dsh-device-auth.git"
  },
  "bugs": {
    "url": "https://github.com/nypyp/dsh-device-auth/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-auth": "./bin/dsh-auth.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "authentication",
    "device-credentials",
    "remote-access",
    "security"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:unit": "node --test \"test/unit.test.mjs\"",
    "test:acceptance": "bash test/acceptance.sh",
    "check": "node --check lib/index.js && node --check lib/store.mjs && node --check bin/dsh-auth.mjs && bash -n test/acceptance.sh",
    "pack:check": "npm pack --dry-run"
  }
}
